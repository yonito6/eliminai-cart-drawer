{%- if settings.cart_type == 'drawer' and settings.ccd_enabled != false -%}
  <div id="CartDrawer" class="drawer drawer--right custom-cart-drawer">
    <form id="CartDrawerForm" action="{{ routes.cart_url }}" method="post" novalidate class="drawer__contents">

      <div class="drawer__fixed-header">
        <div class="drawer__header appear-animation appear-delay-1">
          <div class="h2 drawer__title">Your Cart</div>
          <div class="drawer__close">
            <button type="button" class="drawer__close-button js-drawer-close" aria-label="Close cart">
              <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 64 64"><path d="M19 17.61l27.12 27.13m0-27.12L19 44.74" stroke="currentColor" stroke-width="3" fill="none"/></svg>
              <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
            </button>
          </div>
        </div>

        <style>
  #CartDrawer.custom-cart-drawer {
    --ccd-primary: {{ settings.ccd_color_primary | default: '#111111' }};
    --ccd-bg: {{ settings.ccd_color_background | default: '#ffffff' }};
    --ccd-progress-bg: {{ settings.ccd_color_progress_bg | default: '#dddddd' }};
    --ccd-success: {{ settings.ccd_color_success | default: '#1a7a1a' }};
    --ccd-mobile-width: {{ settings.ccd_mobile_width | default: 78 }}%;
    --ccd-scarcity-color: {{ settings.ccd_scarcity_color | default: "#d32f2f" }};
    --ccd-scarcity-bg: {{ settings.ccd_scarcity_bg | default: "#fff3f3" }};
  }
  </style>
  <script>
  window.CCD_CONFIG = {
    enabled: {{ settings.ccd_enabled | default: true }},
    protectionEnabled: {{ settings.ccd_protection_enabled | default: true }},
    protectionHandle: {{ settings.ccd_protection_handle | default: 'shipping-protection-1' | json }},
    protectionVariantId: {{ settings.ccd_protection_variant_id | default: '47779174023419' | json }},
    protectionAutoAdd: {{ settings.ccd_protection_auto_add | default: true }},
    progressEnabled: {{ settings.ccd_progress_enabled | default: true }},
    promoGoal: {{ settings.ccd_promo_goal | default: 3 }},
    giftEnabled: {{ settings.ccd_gift_enabled | default: true }},
    giftHandle: {{ settings.ccd_gift_handle | default: 'eleganto-premium-watch-organizer' | json }},
    giftVariantId: {{ settings.ccd_gift_variant_id | default: '46941745742075' | json }},
    giftGoal: {{ settings.ccd_gift_goal | default: 3 }},
    colorPrimary: {{ settings.ccd_color_primary | default: '#111111' | json }},
    colorBackground: {{ settings.ccd_color_background | default: '#ffffff' | json }},
    colorProgressBg: {{ settings.ccd_color_progress_bg | default: '#dddddd' | json }},
    colorSuccess: {{ settings.ccd_color_success | default: '#1a7a1a' | json }},
    mobileWidth: {{ settings.ccd_mobile_width | default: 78 }},
    scarcityEnabled: {% if settings.ccd_scarcity_enabled == false %}false{% else %}true{% endif %},
    scarcityTarget: {{ settings.ccd_scarcity_target | default: "2" | json }},
    scarcityText: {{ settings.ccd_scarcity_text | default: "Only 1 left!" | json }},
    scarcityColor: {{ settings.ccd_scarcity_color | default: "#d32f2f" | json }},
    scarcityBg: {{ settings.ccd_scarcity_bg | default: "#fff3f3" | json }},
    scarcityIcon: {{ settings.ccd_scarcity_icon | default: "fire" | json }},
    scarcityLockQty: {{ settings.ccd_scarcity_lock_qty | default: true }},
    scarcityToastMsg: {{ settings.ccd_scarcity_toast_msg | default: "Only 1 left \u2014 already in your cart!" | json }}
  };
  </script>

        {%- assign ccd_prot_handle = settings.ccd_protection_handle | default: 'shipping-protection-1' -%}
        {%- assign ccd_gift_handle = settings.ccd_gift_handle | default: 'eleganto-premium-watch-organizer' -%}
        {%- assign ccd_gift_cprice = settings.ccd_gift_compare_price | default: '$49.99' -%}
        {%- assign real_item_count = 0 -%}
        {%- assign unique_variant_count = 0 -%}
        {%- assign seen_variants = '' -%}
        {%- assign watch_count = 0 -%}
        {%- assign seen_watch_pids = '' -%}
        {%- for item in cart.items -%}
          {%- unless item.handle == ccd_prot_handle or item.handle == ccd_gift_handle -%}
            {%- assign real_item_count = real_item_count | plus: item.quantity -%}
            {%- assign vid_str = item.variant_id | append: ',' -%}
            {%- unless seen_variants contains vid_str -%}
              {%- assign unique_variant_count = unique_variant_count | plus: 1 -%}
              {%- assign seen_variants = seen_variants | append: vid_str -%}
            {%- endunless -%}
            {%- if item.product.tags contains 'watch' -%}
              {%- assign pid_str = item.product_id | append: ',' -%}
              {%- unless seen_watch_pids contains pid_str -%}
                {%- assign watch_count = watch_count | plus: 1 -%}
                {%- assign seen_watch_pids = seen_watch_pids | append: pid_str -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- assign items_remaining = settings.ccd_promo_goal | minus: real_item_count -%}
        {%- if items_remaining < 0 -%}{%- assign items_remaining = 0 -%}{%- endif -%}
        {%- assign promo_reached = false -%}
        {%- if real_item_count >= settings.ccd_promo_goal -%}{%- assign promo_reached = true -%}{%- endif -%}
        {%- assign shipping_reached = false -%}
        {%- if real_item_count >= 1 -%}{%- assign shipping_reached = true -%}{%- endif -%}

        <div class="ccd-progress appear-animation appear-delay-1" data-ccd-progress {% if real_item_count == 0 %}style="display:none"{% endif %}>
          <div class="ccd-progress__message" data-ccd-progress-msg>
            {%- if promo_reached -%}
              🎉 You've unlocked all rewards <strong>(expires soon)</strong>
            {%- else -%}
              Add <strong>{{ items_remaining }}</strong> more for <strong>FREE</strong>
            {%- endif -%}
          </div>
          <div class="ccd-progress__bar-wrap">
            <div class="ccd-progress__line ccd-progress__line--first {% if shipping_reached %}ccd-progress__line--filled{% endif %}"></div>
            <div class="ccd-progress__milestone ccd-progress__milestone--shipping {% if shipping_reached %}ccd-progress__milestone--reached{% endif %}">
              <div class="ccd-progress__icon {% if shipping_reached %}ccd-progress__icon--reached{% endif %}">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
              </div>
              <span class="ccd-progress__label">{{ settings.ccd_milestone1_label }}</span>
            </div>
            <div class="ccd-progress__line ccd-progress__line--second {% if promo_reached %}ccd-progress__line--filled{% endif %}"></div>
            <div class="ccd-progress__milestone ccd-progress__milestone--promo {% if promo_reached %}ccd-progress__milestone--reached{% endif %}">
              <div class="ccd-progress__icon {% if promo_reached %}ccd-progress__icon--reached{% endif %}">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
              </div>
              <span class="ccd-progress__label">{{ settings.ccd_milestone2_label }}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="drawer__inner" data-ccd-inner {% if real_item_count == 0 %}style="display:none"{% endif %}>
        <div class="drawer__scrollable">
          <div data-products class="appear-animation appear-delay-2">
            <div class="cart__items" data-count="{{ cart.item_count }}" data-real-count="{{ real_item_count }}" data-unique-count="{{ unique_variant_count }}" data-watch-count="{{ watch_count }}" data-cart-subtotal="{{ cart.total_price }}">
              {%- for item in cart.items -%}
                {%- unless item.handle == ccd_prot_handle or item.handle == ccd_gift_handle -%}
                  {%- render 'cart-item', product: item -%}
                {%- endunless -%}
              {%- endfor -%}

              {%- for item in cart.items -%}
                {%- if item.handle == ccd_gift_handle -%}
                  <div class="ccd-gift-item" data-key="{{ item.key }}" data-handle="{{ ccd_gift_handle }}">
                    <div class="ccd-gift-label">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/></svg>
                      {{ settings.ccd_gift_label }}
                      <button type="button" class="ccd-gift-item__remove" data-key="{{ item.key }}" aria-label="Remove gift">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                      </button>
                    </div>
                    <div class="ccd-gift-item__body">
                      <div class="ccd-item__image">
                        <a href="{{ item.url }}">
                          <img src="{{ item | img_url: '180x' }}" alt="{{ item.product.title | escape }}">
                        </a>
                      </div>
                      <div class="ccd-gift-item__info">
                        <a href="{{ item.url }}" class="ccd-item__name" style="font-size:13px">{{ item.product.title }}</a>
                        <div class="ccd-gift-item__price-row">
                          <span class="ccd-item__compare-price">{{ ccd_gift_cprice }}</span>
                          <span class="ccd-item__price ccd-item__price--free">Free</span>
                        </div>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>

      <div class="ccd-sticky-footer" data-ccd-footer {% if real_item_count == 0 %}style="display:none"{% endif %}>
        <div class="ccd-shipping-protection">
          <div class="ccd-shipping-protection__icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
          </div>
          <div class="ccd-shipping-protection__info">
            <div class="ccd-shipping-protection__title">Shipping Protection</div>
            <div class="ccd-shipping-protection__desc">against Damage, Loss &amp; Theft</div>
          </div>
          <div class="ccd-shipping-protection__right">
            <span class="ccd-shipping-protection__price">{{ settings.ccd_protection_price }}</span>
            <label class="ccd-toggle">
              {%- assign has_protection = false -%}
              {%- for item in cart.items -%}
                {%- if item.handle == ccd_prot_handle or item.product.title == 'Shipping Protection' -%}
                  {%- assign has_protection = true -%}
                {%- endif -%}
              {%- endfor -%}
              <input type="checkbox" id="ccd-shipping-toggle" checked>
              <span class="ccd-toggle__slider ccd-toggle--instant"></span>
            </label>
          </div>
        </div>

        {%- if cart.total_discount > 0 -%}
          <div class="ccd-discount-row" data-ccd-discounts>
            <div class="ccd-discount-row__left">
              <span class="ccd-discount-row__label">Discount</span>
              {%- assign shown_titles = '' -%}
              {%- for cd in cart.cart_level_discount_applications -%}
                <span class="ccd-discount-row__promo-name"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg> {{ cd.title }}</span>
                {%- assign shown_titles = shown_titles | append: cd.title | append: '|' -%}
              {%- endfor -%}
              {%- for item in cart.items -%}{%- for da in item.line_level_discount_allocations -%}{%- unless shown_titles contains da.discount_application.title -%}
                <span class="ccd-discount-row__promo-name"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg> {{ da.discount_application.title }}</span>
                {%- assign shown_titles = shown_titles | append: da.discount_application.title | append: '|' -%}
              {%- endunless -%}{%- endfor -%}{%- endfor -%}
            </div>
            <span class="ccd-discount-row__amount">-{{ cart.total_discount | money }}</span>
          </div>
        {%- else -%}
          <div class="ccd-discount-row" data-ccd-discounts style="display:none">
            <div class="ccd-discount-row__left"><span class="ccd-discount-row__label">Discount</span></div>
            <span class="ccd-discount-row__amount"></span>
          </div>
        {%- endif -%}

        <button type="submit" name="checkout" class="ccd-checkout-btn" data-terms-required="{{ settings.cart_terms_conditions_enable }}">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
          {{ settings.ccd_checkout_text }} &middot; <span class="ccd-checkout-total" data-subtotal>{{ cart.total_price | money }}</span>
        </button>
        {% if additional_checkout_buttons and settings.cart_additional_buttons %}
          <div class="custom-checkout-buttons-wrapper" style="margin-top: 4px;">{{ content_for_additional_checkout_buttons }}</div>
        {% endif %}
        <div class="ccd-trust">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 5V2L8 6l4 4V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
          <span><strong>30 day</strong> risk free returns</span>
        </div>
      </div>

      <div class="drawer__cart-empty appear-animation appear-delay-2" {% if real_item_count > 0 %}style="display:none"{% endif %}>
        <div style="padding: 32px 20px; text-align: center;">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="#bbb" style="margin-bottom: 12px;"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
          <p style="color: #888; font-size: 15px; margin-bottom: 12px;">Your cart is empty</p>
          <a href="/collections/all" onclick="if(window._ccdReturnUrl){window.location.href=window._ccdReturnUrl;return false;}" style="display: inline-block; padding: 12px 28px; background: #111; border: none; border-radius: 6px; color: #fff; text-decoration: none; font-size: 14px; letter-spacing: 0.5px;">Continue Shopping</a>
        </div>
      </div>
    </form>
  </div>
{%- endif -%}
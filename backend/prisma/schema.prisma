generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperimentStatus {
  BASELINE
  RUNNING
  WINNER_FOUND
  NO_DIFFERENCE
  REVERTED
  PAUSED
  INVALIDATED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

enum EventType {
  CART_OPENED
  CHECKOUT_CLICKED
  CHECKOUT_STARTED
  ORDER_COMPLETED
}

model Store {
  id                    String    @id @default(cuid())
  shopDomain            String    @unique
  shopName              String    @default("")
  accessToken           String
  currency              String    @default("USD")
  config                Json      @default("{}")
  baselineCheckoutRate  Float?
  baselineCartOpens     Int       @default(0)
  isActive              Boolean   @default(true)
  installedAt           DateTime  @default(now())

  experiments           Experiment[]
  visitorSessions       VisitorSession[]
  events                Event[]
  dailySummaries        DailySummary[]
}

model Experiment {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id])
  name            String
  slot            String
  status          ExperimentStatus  @default(RUNNING)
  variants        Json
  winnerVariantId String?
  confidence      Float             @default(0)
  liftPercent     Float?
  trafficSplit    Json              @default("{}")
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  maxDays         Int               @default(14)

  assignments     VariantAssignment[]
  dailySummaries  DailySummary[]

  @@index([storeId, status])
}

model VisitorSession {
  id              String     @id @default(cuid())
  storeId         String
  store           Store      @relation(fields: [storeId], references: [id])
  sessionToken    String     @unique
  deviceType      DeviceType @default(DESKTOP)
  isReturning     Boolean    @default(false)
  referralSource  String?
  country         String?
  firstSeenAt     DateTime   @default(now())

  assignments     VariantAssignment[]
  events          Event[]

  @@index([storeId])
}

model VariantAssignment {
  id              String          @id @default(cuid())
  storeId         String
  experimentId    String
  experiment      Experiment      @relation(fields: [experimentId], references: [id])
  sessionId       String
  session         VisitorSession  @relation(fields: [sessionId], references: [id])
  variantId       String
  assignedAt      DateTime        @default(now())

  events          Event[]

  @@unique([experimentId, sessionId])
  @@index([experimentId, variantId])
}

model Event {
  id              String             @id @default(cuid())
  storeId         String
  store           Store              @relation(fields: [storeId], references: [id])
  sessionId       String
  session         VisitorSession     @relation(fields: [sessionId], references: [id])
  assignmentId    String?
  assignment      VariantAssignment? @relation(fields: [assignmentId], references: [id])
  eventType       EventType
  hourOfDay       Int
  dayOfWeek       Int
  metadata        Json?
  createdAt       DateTime           @default(now())

  @@index([storeId, eventType, createdAt])
  @@index([assignmentId, eventType])
}

model DailySummary {
  id              String      @id @default(cuid())
  storeId         String
  experimentId    String
  experiment      Experiment  @relation(fields: [experimentId], references: [id])
  variantId       String
  date            DateTime    @db.Date
  currency        String      @default("USD")
  cartOpens       Int         @default(0)
  checkoutClicks  Int         @default(0)
  checkoutStarts  Int         @default(0)
  ordersCompleted Int         @default(0)
  totalRevenue    Int         @default(0)
  uniqueVisitors  Int         @default(0)

  store           Store       @relation(fields: [storeId], references: [id])

  @@unique([experimentId, variantId, date])
  @@index([storeId, date])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                   String           @id @default(cuid())
  shopDomain           String           @unique
  shopName             String           @default("")
  accessToken          String
  currency             String           @default("USD")
  config               Json             @default("{}")
  baselineCheckoutRate Float?
  baselineCartOpens    Int              @default(0)
  isActive             Boolean          @default(true)
  installedAt          DateTime         @default(now())
  demoConfig           Json             @default("{}")
  demoThemeId          String?
  featureFlags           Json             @default("{}")
  editorOverrides        Json?
  editorOverridesVersion Int              @default(0)
  dailySummaries         DailySummary[]
  events               Event[]
  experiments          Experiment[]
  visitorSessions      VisitorSession[]
}

model Experiment {
  id              String              @id @default(cuid())
  storeId         String
  name            String
  slot            String
  status          ExperimentStatus    @default(RUNNING)
  variants        Json
  winnerVariantId String?
  confidence      Float               @default(0)
  liftPercent     Float?
  trafficSplit    Json                @default("{}")
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  maxDays         Int                 @default(14)
  notes           Json?
  tournament      Json?
  expectedLoss    Float?
  dailySummaries  DailySummary[]
  store           Store               @relation(fields: [storeId], references: [id])
  assignments     VariantAssignment[]

  @@index([storeId, status])
}

model VisitorSession {
  id             String              @id @default(cuid())
  storeId        String
  sessionToken   String              @unique
  deviceType     DeviceType          @default(DESKTOP)
  isReturning    Boolean             @default(false)
  referralSource String?
  country        String?
  firstSeenAt    DateTime            @default(now())
  hasCustomerId  Boolean             @default(false)
  segment        VisitorSegment      @default(NEW_VISITOR)
  visitCount     Int                 @default(1)
  events         Event[]
  assignments    VariantAssignment[]
  store          Store               @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, segment])
}

model VariantAssignment {
  id           String         @id @default(cuid())
  storeId      String
  experimentId String
  sessionId    String
  variantId    String
  assignedAt   DateTime       @default(now())
  events       Event[]
  experiment   Experiment     @relation(fields: [experimentId], references: [id])
  session      VisitorSession @relation(fields: [sessionId], references: [id])

  @@unique([experimentId, sessionId])
  @@index([experimentId, variantId])
}

model Event {
  id           String             @id @default(cuid())
  storeId      String
  sessionId    String
  assignmentId String?
  eventType    EventType
  hourOfDay    Int
  dayOfWeek    Int
  metadata     Json?
  createdAt    DateTime           @default(now())
  assignment   VariantAssignment? @relation(fields: [assignmentId], references: [id])
  session      VisitorSession     @relation(fields: [sessionId], references: [id])
  store        Store              @relation(fields: [storeId], references: [id])

  @@index([storeId, eventType, createdAt])
  @@index([assignmentId, eventType])
}

model DailySummary {
  id              String     @id @default(cuid())
  storeId         String
  experimentId    String
  variantId       String
  date            DateTime   @db.Date
  currency        String     @default("USD")
  cartOpens       Int        @default(0)
  checkoutClicks  Int        @default(0)
  checkoutStarts  Int        @default(0)
  ordersCompleted Int        @default(0)
  totalRevenue    Int        @default(0)
  uniqueVisitors  Int        @default(0)
  experiment      Experiment @relation(fields: [experimentId], references: [id])
  store           Store      @relation(fields: [storeId], references: [id])

  @@unique([experimentId, variantId, date])
  @@index([storeId, date])
}

enum ExperimentStatus {
  BASELINE
  RUNNING
  WINNER_FOUND
  NO_DIFFERENCE
  REVERTED
  PAUSED
  INVALIDATED
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
}

enum EventType {
  CART_OPENED
  CHECKOUT_CLICKED
  CHECKOUT_STARTED
  ORDER_COMPLETED
}

enum VisitorSegment {
  NEW_VISITOR
  RETURNING_BROWSER
  CHECKOUT_ABANDONER
  EXISTING_CUSTOMER
}
